# General
PROD=false

# HTTP server
SERVER_HOST=0.0.0.0
SERVER_PORT=13337
# SERVER_TLS_DOMAIN=  # set in prod to enable automatic TLS (Let's Encrypt)

# Authentication (required, but no routes currently enforce it)
AUTH_TOKEN=change_me

# Repository — pick one; priority: EdgeDB > Directus > Static
STATIC=true
# DIRECTUS_URL=https://directus.example.com
# DIRECTUS_TOKEN=change_me
# EDGEDB_DSN=edgedb://user:pass@host/db  # deprecated
